# $Id: local.rules,v 1.11 2004/07/23 20:15:44 bmc Exp $
# ----------------
# LOCAL RULES
# This file intentionally does not come with signatures.  Put your local
# additions here.
# Regle de test initiale - Priorite 3 (Reconnaissance basique)
alert icmp any any -> $HOME_NET any (msg:"LAB ICMP echo request detecte"; itype:8; classtype:attempted-recon; priority:3; sid:1000001; rev:2;)

# Scenario 1 : Scan de ports - Priorite 3 (Reconnaissance active)
alert tcp any any -> $HOME_NET any (msg:"LAB Scan de ports TCP SYN detecte"; flags:S; detection_filter:track by_src, count 20, seconds 5; classtype:network-scan; priority:3; sid:1000002; rev:2;)

# Scenario 2 : Force brute SSH - Priorite 2 (Tentative d'intrusion par dictionnaire)
alert tcp any any -> $HOME_NET 22 (msg:"LAB SSH brute force detecte"; flags:S; detection_filter:track by_src, count 3, seconds 30; classtype:attempted-admin; priority:2; sid:1000003; rev:2;)

# Scenario 3 : Injection SQL - Priorite 1 (Critique : compromission base de donnees)
alert tcp any any -> $HOME_NET 80 (msg:"LAB Injection SQL detectee"; content:"GET "; depth:4; content:"id="; distance:0; content:"%27"; distance:0; within:40; nocase; classtype:web-application-attack; priority:1; sid:1000004; rev:2;)

# Scenario 4 : Traversee de repertoire - Priorite 2 (Divulgation de fichiers locaux)
alert tcp any any -> $HOME_NET 80 (msg:"LAB Traversee de repertoire etc-passwd detectee"; content:"GET "; depth:4; content:"etc"; distance:0; nocase; content:"passwd"; distance:0; nocase; classtype:web-application-attack; priority:2; >

# Scenario 5 : Execution de commande a distance - Priorite 1 (Critique : prise de controle serveur)
alert tcp any any -> $HOME_NET 80 (msg:"LAB Execution de commande a distance detectee"; content:"POST "; depth:5; content:"ip="; distance:0; content:"%3"; distance:0; within:40; classtype:web-application-attack; priority:1; sid:100000>




