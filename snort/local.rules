# Regle de test initiale - validation de la chaine complete
alert icmp any any -> $HOME_NET any (msg:"LAB ICMP echo request detecte"; itype:8; classtype:attempted-recon; sid:1000001; rev:1;)

# Scenario 1 - Reconnaissance : scan de ports TCP SYN (nmap)
alert tcp any any -> $HOME_NET any (msg:"LAB Scan de ports TCP SYN detecte"; flags:S; detection_filter:track by_src, count 20, seconds 5; classtype:network-scan; sid:1000002; rev:1;)

# Scenario 2 - Force brute SSH (hydra)
alert tcp any any -> $HOME_NET 22 (msg:"LAB SSH brute force detecte"; flags:S; detection_filter:track by_src, count 3, seconds 30; classtype:attempted-admin; sid:1000003; rev:1;)

# Scenario 3 - Injection SQL (DVWA)
alert tcp any any -> $HOME_NET 80 (msg:"LAB Injection SQL detectee"; content:"GET "; depth:4; content:"id="; distance:0; content:"%27"; distance:0; within:40; nocase; classtype:web-application-attack; sid:1000004; rev:1;)

# Scenario 4 - Traversee de repertoire /etc/passwd (DVWA)
alert tcp any any -> $HOME_NET 80 (msg:"LAB Traversee de repertoire etc-passwd detectee"; content:"GET "; depth:4; content:"etc"; distance:0; nocase; content:"passwd"; distance:0; nocase; classtype:web-application-attack; sid:1000005; rev:1;)

# Scenario 5 - Execution de commande a distance / RCE (DVWA)
alert tcp any any -> $HOME_NET 80 (msg:"LAB Execution de commande a distance detectee"; content:"POST "; depth:5; content:"ip="; distance:0; content:"%3"; distance:0; within:40; classtype:web-application-attack; sid:1000006; rev:1;)
