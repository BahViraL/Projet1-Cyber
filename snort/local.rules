# Scenario 1 : Scan de ports furtif Nmap (SYN Scan) - Seuil relevé à 50 paquets pour éviter le bruit
alert tcp any any -> 192.168.56.102 any (msg:"[IDS-SCENARIO-1] Reconnaissance - Scan de ports Nmap SYN detecte"; flags:S; detection_filter:track by_src, count 50, seconds 10; sid:1000001; rev:4;)

# Scenario 2 : Tentative d'Injection SQL (Exploitation Web sur port 80 de la cible)
alert tcp any any -> 192.168.56.102 80 (msg:"[IDS-SCENARIO-2] Web Attack - Tentative Injection SQL"; content:"UNION",nocase; content:"SELECT",nocase; sid:1000002; rev:4;)

# Scenario 3 : Path Traversal / LFI vers /etc/passwd sur la cible
alert tcp any any -> 192.168.56.102 80 (msg:"[IDS-SCENARIO-3] Web Attack - Path Traversal lecture /etc/passwd"; content:"passwd",nocase; sid:1000003; rev:4;)

# Scenario 4 : Attaque par Force Brute sur le port SSH (22) de la cible
alert tcp any any -> 192.168.56.102 22 (msg:"[IDS-SCENARIO-4] BruteForce - Multiples connexions SSH rapides"; flags:S; detection_filter:track by_src, count 4, seconds 30; sid:1000004; rev:4;)

# Scenario 5 : Command Injection / RCE via HTTP sur la cible
alert tcp any any -> 192.168.56.102 80 (msg:"[IDS-SCENARIO-5] Exploit - Tentative de Command Injection (bin/sh)"; content:"/bin/sh",nocase; sid:1000005; rev:4;)
